---
import Icon from "./Icon.astro";
import { SITE, buildWhatsappUrl } from "../data/site";

const whatsappUrl = buildWhatsappUrl("Hola, quiero más información sobre Recursos Alfred.");
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-100 bg-white py-12">
  <div class="container-page grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="#inicio" class="flex items-center gap-2 font-extrabold text-slate-900">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-white">
          <Icon name="Sparkles" class="h-4 w-4" />
        </span>
        <span>{SITE.name}<span class="text-brand-600">.online</span></span>
      </a>
      <p class="mt-4 text-sm text-slate-500">
        Automatización, inteligencia artificial y desarrollo de software para pymes de la Costa
        Caribe colombiana.
      </p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-slate-900">Enlaces</h3>
      <ul class="mt-4 space-y-2 text-sm text-slate-500">
        <li><a href="#inicio" class="hover:text-brand-700">Inicio</a></li>
        <li><a href="#herramientas" class="hover:text-brand-700">Herramientas</a></li>
        <li><a href="#servicios" class="hover:text-brand-700">Servicios</a></li>
        <li><a href="#contacto" class="hover:text-brand-700">Contacto</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-slate-900">Contacto</h3>
      <ul class="mt-4 space-y-2 text-sm text-slate-500">
        <li>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-whatsapp-cta="footer" class="hover:text-brand-700">
            WhatsApp
          </a>
        </li>
        <li><a href={`mailto:${SITE.email}`} class="hover:text-brand-700">{SITE.email}</a></li>
        <li><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-brand-700">LinkedIn</a></li>
        <li><a href={SITE.github} target="_blank" rel="noopener noreferrer" class="hover:text-brand-700">GitHub</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-slate-900">Cobertura</h3>
      <p class="mt-4 text-sm text-slate-500">
        {SITE.ciudades.join(", ")} y el resto de la región Caribe de Colombia.
      </p>
    </div>
  </div>

  <div class="container-page mt-10 border-t border-slate-100 pt-6 text-center text-xs text-slate-400">
    © {year} {SITE.name}.online — Todos los derechos reservados.
  </div>
</footer>
