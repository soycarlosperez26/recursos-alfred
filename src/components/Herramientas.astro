---
import Icon from "./Icon.astro";
import ToolCard from "./ToolCard.astro";
import { categorias } from "../data/herramientas";
---

<section id="herramientas" aria-labelledby="herramientas-titulo" class="bg-slate-50/60 py-20 sm:py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-eyebrow">Herramientas para empresas</p>
      <h2 id="herramientas-titulo" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
        Herramientas inteligentes para Recursos Humanos, IA, logística y más
      </h2>
      <p class="mt-4 text-slate-600">
        Elige la herramienta que resuelve el problema de tu empresa y escríbenos por WhatsApp para
        obtenerla.
      </p>
    </div>

    <div class="mt-16 space-y-16">
      {
        categorias.map((cat) => (
          <div id={cat.categoria.toLowerCase().replace(/\s+/g, "-")}>
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 text-white">
                <Icon name={cat.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="text-xl font-bold text-slate-900">{cat.categoria}</h3>
                <p class="text-sm text-slate-500">{cat.descripcion}</p>
              </div>
            </div>

            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {cat.herramientas.map((h) => (
                <ToolCard herramienta={h} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
