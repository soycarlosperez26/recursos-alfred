---
import Icon from "./Icon.astro";
import ToolCard from "./ToolCard.astro";
import { getVisibleToolsByCategory } from "../data/tools.config";

const grupos = getVisibleToolsByCategory();
---

<section id="herramientas" aria-labelledby="herramientas-titulo" class="bg-slate-50/60 py-20 sm:py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-eyebrow">Herramientas para empresas</p>
      <h2 id="herramientas-titulo" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
        Herramientas inteligentes para Recursos Humanos, IA, logística y más
      </h2>
      <p class="mt-4 text-slate-600">
        Elige la herramienta que resuelve el problema de tu empresa y escríbenos por WhatsApp para
        obtenerla.
      </p>
    </div>

    {
      grupos.length === 0 ? (
        <p class="mt-16 text-center text-slate-500">
          Estamos construyendo las primeras herramientas. Muy pronto estarán disponibles aquí.
        </p>
      ) : (
        <div class="mt-16 space-y-16">
          {grupos.map((grupo) => (
            <div id={grupo.category.toLowerCase().replace(/\s+/g, "-")}>
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 text-white">
                  <Icon name={grupo.meta.icon} class="h-5 w-5" />
                </span>
                <div>
                  <h3 class="text-xl font-bold text-slate-900">{grupo.category}</h3>
                  <p class="text-sm text-slate-500">{grupo.meta.descripcion}</p>
                </div>
              </div>

              <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {grupo.tools.map((tool) => (
                  <ToolCard tool={tool} />
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<script is:inline>
  document.addEventListener("click", function (event) {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    const openTrigger = target.closest("[data-open-modal]");
    if (openTrigger) {
      const dialog = document.getElementById(openTrigger.getAttribute("data-open-modal") || "");
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    const closeTrigger = target.closest("[data-close-modal]");
    if (closeTrigger) {
      const dialog = closeTrigger.closest("dialog");
      dialog?.close();
      return;
    }

    // Cierra al hacer clic en el backdrop (fuera del contenido del modal).
    if (target instanceof HTMLDialogElement && target.hasAttribute("open")) {
      const rect = target.getBoundingClientRect();
      const clickedInside =
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width;
      if (!clickedInside) target.close();
    }
  });
</script>
