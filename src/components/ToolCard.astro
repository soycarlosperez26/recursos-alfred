---
import Icon from "./Icon.astro";
import { buildWhatsappUrl } from "../data/site";
import type { Tool } from "../data/tools.config";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const badgeClass: Record<Tool["pricingTier"], string> = {
  Gratis: "badge-gratis",
  Freemium: "badge-freemium",
  Premium: "badge-premium",
};

const whatsappUrl = buildWhatsappUrl(tool.whatsappMessage);
const fullStars = Math.round(Math.min(5, Math.max(0, tool.rate)));
const modalId = `modal-${tool.id}`;
const modalTitleId = `modal-title-${tool.id}`;
const longDescription = tool.longDescription ?? tool.description;
const features = tool.features ?? [];
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white transition hover:border-brand-200 hover:shadow-lg hover:shadow-brand-50">
  <div class="relative aspect-video w-full overflow-hidden bg-brand-50">
    {
      tool.picture ? (
        <img
          src={tool.picture}
          alt={tool.name}
          class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-brand-600">
          <Icon name={tool.icon} class="h-12 w-12" />
        </div>
      )
    }

    <span class={`badge ${badgeClass[tool.pricingTier]} absolute right-3 top-3 shadow-sm`}>
      {tool.pricingTier}
    </span>

    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-slate-900/0 opacity-0 transition-all duration-200 group-hover:bg-slate-900/55 group-hover:opacity-100 group-focus-within:bg-slate-900/55 group-focus-within:opacity-100">
      <button
        type="button"
        data-open-modal={modalId}
        class="cursor-pointer btn-secondary translate-y-1 !py-2 text-sm opacity-0 transition duration-200 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100"
      >
        Más información
      </button>
      {
        tool.hasDemo && tool.demoUrl && (
          <a
            href={tool.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary translate-y-1 !py-2 text-sm opacity-0 transition delay-75 duration-200 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100"
          >
            Ver Demo
          </a>
        )
      }
    </div>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-semibold text-slate-900">{tool.name}</h3>
    <p class="mt-2 line-clamp-3 flex-1 text-sm text-slate-600">{tool.description}</p>

    {
      tool.rate > 0 && (
        <div class="mt-3 flex items-center gap-0.5" aria-label={`Calificación: ${tool.rate} de 5`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <Icon
              name="Star"
              class={`h-4 w-4 ${i < fullStars ? "fill-amber-400 text-amber-400" : "text-slate-200"}`}
            />
          ))}
        </div>
      )
    }
  </div>
</article>

<dialog id={modalId} class="tool-modal" aria-labelledby={modalTitleId}>
  <div class="max-h-[85vh] overflow-y-auto">
    <div class="relative aspect-video w-full bg-brand-50">
      {
        tool.picture ? (
          <img src={tool.picture} alt={tool.name} class="h-full w-full object-cover" loading="lazy" />
        ) : (
          <div class="flex h-full w-full items-center justify-center text-brand-600">
            <Icon name={tool.icon} class="h-16 w-16" />
          </div>
        )
      }
      <span class={`badge ${badgeClass[tool.pricingTier]} absolute left-3 top-3 shadow-sm`}>
        {tool.pricingTier}
      </span>
      <button
        type="button"
        data-close-modal
        aria-label="Cerrar"
        class="absolute right-3 top-3 rounded-full bg-white/90 p-2 text-slate-700 shadow transition hover:bg-white"
      >
        <Icon name="X" class="h-4 w-4" />
      </button>
    </div>

    <div class="p-6 sm:p-8">
      <p class="section-eyebrow">{tool.category}</p>
      <h3 id={modalTitleId} class="mt-1 text-2xl font-bold text-slate-900">
        {tool.name}
      </h3>

      {
        tool.rate > 0 && (
          <div class="mt-2 flex items-center gap-0.5" aria-label={`Calificación: ${tool.rate} de 5`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <Icon
                name="Star"
                class={`h-4 w-4 ${i < fullStars ? "fill-amber-400 text-amber-400" : "text-slate-200"}`}
              />
            ))}
          </div>
        )
      }

      <p class="mt-4 text-slate-600">{longDescription}</p>

      {
        features.length > 0 && (
          <ul class="mt-4 space-y-2">
            {features.map((feature) => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <Icon name="Check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-cta={`${tool.id}-modal`}
          class="btn-whatsapp flex-1"
        >
          <Icon name="MessageCircle" class="h-4 w-4" />
          Contactar con Alfred
        </a>
        {
          tool.hasDemo && tool.demoUrl && (
            <a href={tool.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary flex-1">
              Ir a Demo
              <Icon name="ArrowRight" class="h-4 w-4" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</dialog>
