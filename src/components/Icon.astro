---
import * as icons from "lucide-astro";

interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "h-6 w-6", strokeWidth = 1.75 } = Astro.props;

const IconComponent = (icons as Record<string, any>)[name] ?? icons.CircleHelp;
---

<IconComponent class={className} stroke-width={strokeWidth} aria-hidden="true" />
