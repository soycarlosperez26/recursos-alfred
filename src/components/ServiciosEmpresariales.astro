---
import Icon from "./Icon.astro";
import { servicios } from "../data/herramientas";
import { buildWhatsappUrl } from "../data/site";

const whatsappUrl = buildWhatsappUrl(
  "Hola, mi empresa necesita una solución personalizada. Quiero solicitar una cotización."
);
---

<section id="servicios" aria-labelledby="servicios-titulo" class="py-20 sm:py-24">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="section-eyebrow">Servicios empresariales</p>
        <h2 id="servicios-titulo" class="mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">
          ¿Necesitas una solución personalizada para tu empresa?
        </h2>
        <p class="mt-4 text-slate-600">
          Si tu empresa necesita integrar sistemas, automatizar procesos o modernizar software
          existente, en Recursos Alfred te ayudamos a resolverlo de principio a fin, sin
          complicaciones técnicas de tu lado.
        </p>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-cta="cotizacion-servicios"
          class="btn-primary mt-8"
        >
          Solicitar Cotización
          <Icon name="ArrowRight" class="h-4 w-4" />
        </a>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {
          servicios.map((s) => (
            <div class="flex items-center gap-3 rounded-xl border border-slate-100 p-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                <Icon name={s.icon} class="h-4 w-4" />
              </span>
              <p class="text-sm font-medium text-slate-800">{s.nombre}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
