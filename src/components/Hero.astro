---
import { SITE, buildWhatsappUrl } from "../data/site";
import Icon from "./Icon.astro";

const whatsappUrl = buildWhatsappUrl("Hola, quiero automatizar procesos en mi empresa.");
---

<section id="inicio" class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white pt-16 pb-20 sm:pt-24 sm:pb-28">
  <div class="container-page grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="section-eyebrow">Para pymes</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Automatiza los procesos de tu empresa sin desarrollar desde cero
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600">
        Creamos herramientas inteligentes de <strong>Recursos Humanos</strong>, <strong>Logística</strong>,
        <strong>Inteligencia Artificial</strong> y <strong>Desarrollo de Software</strong> para pequeñas y
        medianas empresas.
      </p>
      <p class="mt-3 text-base text-slate-500">
        Si tu equipo pierde horas en tareas manuales, hojas de cálculo o procesos en papel, tenemos una
        solución lista para tu negocio.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#herramientas" class="btn-primary">
          Explorar herramientas
          <Icon name="ArrowRight" class="h-4 w-4" />
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-cta="hero"
          class="btn-whatsapp"
        >
          <Icon name="MessageCircle" class="h-4 w-4" />
          Hablar por WhatsApp
        </a>
      </div>

      <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-slate-100 pt-8 text-left">
        <div>
          <dt class="text-2xl font-extrabold text-slate-900">+10</dt>
          <dd class="text-sm text-slate-500">años de experiencia</dd>
        </div>
        <div>
          <dt class="text-2xl font-extrabold text-slate-900">25+</dt>
          <dd class="text-sm text-slate-500">herramientas disponibles</dd>
        </div>
        <div>
          <dt class="text-2xl font-extrabold text-slate-900">7</dt>
          <dd class="text-sm text-slate-500">ciudades de la Costa Caribe</dd>
        </div>
      </dl>
    </div>

    <div class="relative">
      <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-xl shadow-brand-100/50">
        <div class="flex items-center gap-3 rounded-2xl bg-brand-50 p-4">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 text-white">
            <Icon name="Building2" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-sm font-semibold text-slate-900">Tu empresa</p>
            <p class="text-xs text-slate-500">Procesos manuales, tiempo perdido</p>
          </div>
        </div>
        <div class="my-3 flex justify-center">
          <Icon name="ArrowDown" class="h-5 w-5 text-slate-300" />
        </div>
        <div class="flex items-center gap-3 rounded-2xl bg-accent-50 p-4">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-500 text-white">
            <Icon name="Workflow" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-sm font-semibold text-slate-900">Automatización + IA</p>
            <p class="text-xs text-slate-500">Herramientas de Recursos Alfred</p>
          </div>
        </div>
        <div class="my-3 flex justify-center">
          <Icon name="ArrowDown" class="h-5 w-5 text-slate-300" />
        </div>
        <div class="flex items-center gap-3 rounded-2xl bg-slate-50 p-4">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-900 text-white">
            <Icon name="TrendingUp" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-sm font-semibold text-slate-900">Resultados</p>
            <p class="text-xs text-slate-500">Menos tiempo perdido, más ventas</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
