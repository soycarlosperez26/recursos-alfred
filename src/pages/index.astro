---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Beneficios from "../components/Beneficios.astro";
import Herramientas from "../components/Herramientas.astro";
import ServiciosEmpresariales from "../components/ServiciosEmpresariales.astro";
import PorQueElegirnos from "../components/PorQueElegirnos.astro";
import CTAFinal from "../components/CTAFinal.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import AnalyticsEvents from "../components/AnalyticsEvents.astro";
import "../styles/global.css";

const title =
  "Recursos Alfred | Automatización, IA y herramientas para pymes de la Costa Caribe, Colombia";
const description =
  "Herramientas de automatización, inteligencia artificial, recursos humanos y logística para pequeñas y medianas empresas de Barranquilla, Cartagena y la Costa Caribe colombiana. Escríbenos por WhatsApp.";
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Beneficios />
    <Herramientas />
    <ServiciosEmpresariales />
    <PorQueElegirnos />
    <CTAFinal />
  </main>
  <Footer />
  <WhatsAppFloat />
  <AnalyticsEvents />
</Layout>
